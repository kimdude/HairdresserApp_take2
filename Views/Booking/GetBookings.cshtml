@using System.Globalization
@model IEnumerable<HairdresserApp.Models.Booking>
@{
    ViewData[index: "Title"] = "Bokningar";
}

<section>
    <h1>Bokningar</h1>

    @* Filter *@
    <form asp-action="GetBookings" method="post" id="filterForm">
        @Html.AntiForgeryToken()
        
        @* Hairdresser selection *@
        <div>
            <label for="hairdresser">Frisör: </label>
            <select id="hairdresser" name="hairdresser" asp-items="ViewBag.Hairdressers">
                <option value="">Alla</option>
            </select>
        </div>

        @* Timeframe selection *@
        <div>
            <label>
                <input type="radio" name="timeframe" value="today" checked />
                Idag
            </label>

            <label>
                <input type="radio" name="timeframe" value="week" />
                Veckan
            </label>
        </div>

        <button type="submit">Filtrera</button>
    </form>

    @* Bookings overview *@
    <table class="calendar allBookings">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Tid</th>
                <th>Kund</th>
                <th>Tjänst</th>
                <th>Frisör</th>
                <th>Pris</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if(Model.Count() == 0) {
                <tr><td colspan="7">Inga bokningar</td></tr>
            } else {
                @foreach(Booking booking in Model) {
                <tr>
                    <td>@booking.DateAndTime.ToString("ddd dd'/'MM", new CultureInfo("sv-EU"))</td>
                    <td>@booking.DateAndTime.ToString("HH:mm")</td>
                    <td>@booking.Customer?.Fname @booking.Customer?.Lname</td>
                    <td>@foreach(BookedService bookedService in booking.BookedServices) {
                            @bookedService.Service?.Title
                        }  
                    </td>
                    <td>@booking.Hairdresser?.Fname @booking.Hairdresser?.Lname</td>
                    <td>@booking.TotalCost</td>
                    <td>

                        @* Delete btn *@
                        <form asp-action="DeleteBooking" method="post">
                            <input type="hidden" name="id" value="@booking.Id" />
                            <button type="submit" class="deleteBtn">Avboka</button>
                        </form>

                        @* Edit btn *@
                        <a asp-action="UpdateBooking" asp-route-id="@booking.Id">Omboka</a>
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>

</section>