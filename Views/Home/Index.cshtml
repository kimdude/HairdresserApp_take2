@model  IEnumerable<HairdresserApp.Models.Service>
@{
    /* View over available bookings for customers */
    
    ViewData["Title"] = "Våra tjänster";
}

<div class="text-center m-4">
    <h1 class="display-4">Välkommen!</h1>
    <p>Boka tid genom att välja tjänst nedan.</p>
</div>

<section class="m-4">
    <h2>Våra tjänster</h2>

    <!-- All available services -->
    <div class="row g-4">
        @if(Model.Any()) {
            foreach(Service service in Model) {
                <div class="col-12 col-sm-6 col-md-4">
                    <article class="card">
                        <div class="card-body">
                            <h3 class="card-title">@service.Title</h3>

                            <!-- Service details -->
                            <div class="d-flex gap-3">
                                <p class="card-text">Tid: @service.Duration min</p>
                                <p class="card-text">Pris: @Math.Round(service.Price ?? 0) kr</p>
                            </div>

                            <!-- Service description -->
                            <p class="card-text">@service.Description</p>

                            <!-- Book service -->
                            <div class="d-grid gap-2">
                                <a class="btn btn-gp-primary" asp-action="CreateBooking" asp-controller="Booking" asp-route-serviceId="@service.Id" asp-route-serviceTitle="@service.Title">Boka @service.Title</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        } 
        else 
        {
            <p>Just nu finns inga tjänster tillgängliga.</p>
        }
    </div>
</section>
