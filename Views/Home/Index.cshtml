@model  IEnumerable<HairdresserApp.Models.Service>
@{
    /* View over available bookings for customers */
    
    ViewData["Title"] = "Våra tjänster";
}

<div class="text-center">
    <h1 class="display-4">Välkommen!</h1>
    <p>Boka tid genom att välja tjänst nedan.</p>
</div>

<section>
    <h2>Våra tjänster</h2>

    <!-- All available services -->
    <div id="serviceContainer">
        @foreach(Service service in Model) {
            <article class="serviceBlock">
                <h3>
                    @service.Title
                </h3>

                <!-- Details -->
                <div class="serviceDetails">
                    <p>
                        Tid: @service.Duration
                    </p>
                    <p>
                        Pris: @service.Price
                    </p>
                </div>

                <p>
                    @service.Description
                </p>

                <!-- Booking action -->
                <a class="beigeBtn" asp-action="CreateBooking" asp-controller="Booking" asp-route-serviceId="@service.Id" asp-route-serviceTitle="@service.Title">Boka</a>
            </article>
        }
    </div>
</section>
