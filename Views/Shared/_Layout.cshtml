<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Frisör'n</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HairdresserApp.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.svg" />
</head>
<body>
    <header class="p-3">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo_light.svg" width="110" alt="Frisör'n" />
        </a>
    </header>
    <nav class="navbar navbar-expand-lg">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a asp-controller="Booking" asp-action="GetBookings" class="nav-link">Bokningar</a>
            </li>
            <li class="nav-item">
                <a asp-controller="Service" asp-action="GetServices" class="nav-link">Tjänster</a>
            </li>
            <li class="nav-item">
                <a asp-controller="Hairdresser" asp-action="GetHairdressers" class="nav-link">Frisörer</a>
            </li>
        </ul>
    </nav>
    <div class="container">
        <main role="main" class="p-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted p-3">
        <div class="container">
            <partial name="_LoginPartial" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
