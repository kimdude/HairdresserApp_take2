@model HairdresserApp.Models.Hairdresser
    
@{
    /* View to update hairdresser */

    ViewData[index: "Title"] = "Uppdatera frisör";
}

<section class="m-4">
    <h1>Uppdatera @Model.Fname</h1>

    <form asp-action="UpdateHairdresser" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
         
        <div>
            <label asp-for="Fname" class="form-label">Förnamn: </label>
            <input asp-for="Fname" value="@Model.Fname" class="form-control"/>
            <span asp-validation-for="Fname" class="text-danger"></span>
        </div>

        <div class="mt-2">
            <label asp-for="Lname" class="form-label">Efternamn: </label>
            <input asp-for="Lname" value="@Model.Lname" class="form-control" />
            <span asp-validation-for="Lname" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2 col-1 mx-auto">
            <input type="submit" value="Uppdatera" class="btn btn-gp-primary mt-3" />
        </div>
    </form>
</section>