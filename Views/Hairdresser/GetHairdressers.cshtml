@model IEnumerable<HairdresserApp.Models.Hairdresser>
    
@{
    /* View over hairdressers */

    ViewData[index: "Title"] = "Frisörer";
}

<section>
    <h1>Frisörer</h1>

    @foreach(var hairdresser in Model) {
        <article class="userArticle">
            <h2>@hairdresser.Fname @hairdresser.Lname</h2>
            <p>@hairdresser.User.Email</p>

            <div>
                <a asp-action="UpdateHairdresser" asp-route-id="@hairdresser.Id">Redigera</a>

                <form asp-action="DeleteHairdresser" method="post">
                    <input type="hidden" name="id" value="@hairdresser.Id" />
                    <input type="submit" value="Ta bort" />
                </form>
            </div>
        </article>
    }

    <a class="beigeBtn" asp-area="Identity" asp-page="/Account/Register">Ny frisör</a>
</section>