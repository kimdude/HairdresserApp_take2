@model HairdresserApp.Models.OfferedService
    
@{
    /* View to add offered service */

    ViewData[index: "Title"] = "Lägg till frisör för tjänst";
}

<section class="m-4">
    <h1>@ViewBag.ServiceTitle</h1>
    <p><strong>Lägg till frisör som erbjuder tjänsten.</strong></p>

    <form asp-action="AddOfferedService" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Hidden inputs -->
        <input type="hidden" asp-for="ServiceId" value="@ViewBag.ServiceId"/>
        <input type="hidden" name="ServiceTitle" value="@ViewBag.ServiceTitle"/>

        <div>
            <label asp-for="HairdresserId" class="form-label">Frisör: </label>
            <select asp-for="HairdresserId" asp-items="ViewBag.Hairdresser" class="form-select">
                <option value="0" selected disabled>Välj</option>
            </select>
            <span asp-validation-for="HairdresserId" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2 col-1 mx-auto">
            <input type="submit" value="Uppdatera" class="btn btn-gp-primary mt-4"/>
        </div>
    </form>
</section>