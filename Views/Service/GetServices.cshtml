@model IEnumerable<HairdresserApp.Models.Service>
    
@{
    /* View to add service */

    ViewData[index: "Title"] = "Tjänster";
}

<section>
    <h1>Alla tjänster</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Tjänst</th>
                <th>Tid</th>
                <th>Pris</th>
                <th>Erbjuds</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var service in Model) {
                <tr>
                    <td><a asp-action="ServiceDetails" asp-route-id="@service.Id">@service.Title</a></td>
                    <td><a asp-action="ServiceDetails" asp-route-id="@service.Id">@service.Duration</a></td>
                    <td><a asp-action="ServiceDetails" asp-route-id="@service.Id">@service.Price</a></td>
                    @if(service.OfferedServices.Any()) {
                        <td class="availableService">
                            <a asp-action="ServiceDetails" asp-route-id="@service.Id">Erbjuds</a>
                        </td>
                    } 
                    else 
                    {
                        <td class="unavailableService">
                            <a asp-action="ServiceDetails" asp-route-id="@service.Id">Erbjuds ej</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <!-- Adding new service -->
    <a asp-action="CreateService" class="beigeBtn">Ny tjänst</a>
</section>