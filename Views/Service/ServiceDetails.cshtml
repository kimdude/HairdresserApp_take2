@model HairdresserApp.Models.Service
    
@{
    /* View to update service */

    ViewData[index: "Title"] = "Om tjänsten";
}

<section>
    
    <div class="titleContainer">
        <h1>@Model.Title</h1>

        <div>
            @* Delete Button *@
            <form method="post" asp-action="DeleteService">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="submit" value="Ta bort" class="adminBtn adminDeleteBtn" />
            </form>

            <a asp-action="AddOfferedService" asp-route-id="@Model.Id" asp-route-title="@Model.Title" class="adminBtn">Lägg till frisör</a>
            <a asp-action="UpdateService" asp-route-id="@Model.Id" class="adminBtn">Redigera</a>
        </div>
    </div>

    @* Service details *@
    <div class="serviceDetails">
        <p>Tid: @Model.Duration</p>
        <p>Pris: @Model.Price kr</p>
    </div>

    @* Service description *@
    <p>@Model.Description</p>

    @* Hairstylists offering *@
    <p><strong>Erbjuds av:</strong></p>
    @if(Model.OfferedServices.Count == 0) {
        <p>Tjänsten erbjuds inte</p>
    } else {
    <ul>
        @foreach(var service in Model.OfferedServices) {
            <li>
                @service.Hairdresser?.Fname @service.Hairdresser?.Lname

                <form method="post" asp-action="DeleteOfferedService">
                    <input type="hidden" name="hairdresserId" value="@service.HairdresserId" />
                    <input type="hidden" name="serviceId" value="@service.ServiceId" />
                    <input type="submit" value="Ta bort" class="smallDeleteBtn" />
                </form>
            </li>
        }
    </ul>
    }
</section>